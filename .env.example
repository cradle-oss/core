# CORE model/provider configuration.
#
# Precedence:
#   1. CORE_MODEL selects a specific model and determines the provider
#      (openrouter/* -> OpenRouter, anything else -> direct OpenAI).
#   2. Otherwise OPENROUTER_API_KEY -> openrouter/auto (default route).
#   3. Otherwise OPENAI_API_KEY -> direct OpenAI with the current default model.
#
# Set whichever key you intend to use. Never commit real keys.

# Optional: pin a specific model (OpenRouter route or OpenAI model name).
# export CORE_MODEL=gpt-6-astra
# export CORE_MODEL=openrouter/auto

# Recommended default: OpenRouter adaptive routing (supports tool calling).
export OPENROUTER_API_KEY=your-openrouter-key-here

# Direct OpenAI access (only used when OPENROUTER_API_KEY is absent).
export OPENAI_API_KEY=your-openai-key-here
# OpenCode Zen: free, bare tool-capable model ids. CORE uses Zen as a
# fallback when no explicit zen/<model> route or OPENROUTER key is set.
export CORE_ZEN_API_KEY=your-zen-key-here
